# Project clangd config, applied on top of each file's compile flags from
# compile_commands.json (generated by ./gen-compdb.sh). clangd reads this after
# your global ~/.clangd, so the Remove entries below take effect for this repo.

CompileFlags:
  Remove:
    # The build runs with -Werror; in the editor that turns every warning into a
    # red squiggle. Drop it so diagnostics surface as warnings, not errors.
    - -Werror
    # Your global ~/.clangd forces -std=c17 on .c files, which overrides the
    # build's -std=gnu11 and makes clangd flag the GNU extensions the AM/klib
    # code uses. Removing it lets the CDB's -std=gnu11 win so clangd parses the
    # same dialect gcc does.
    - -std=c17

# Project-wide background index -> go-to-definition works across files you have
# not opened. YouCompleteMe's clangd-completer already passes --background-index,
# so this is a harmless no-op there and a help if you ever run clangd directly.
Index:
  Background: Build